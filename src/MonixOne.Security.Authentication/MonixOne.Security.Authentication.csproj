<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>MonixOne.Security.Authentication</PackageId>
        <Title>MonixOne.Security.Authentication</Title>
        <Description>JWT Bearer authentication and OAuth scope authorization for ASP.NET Core resource servers.</Description>
        <PackageTags>aspnetcore;authentication;authorization;oauth2;openid-connect;jwt</PackageTags>
        <PackageIcon>nuget-icon.png</PackageIcon>
        <Authors>Shulyakovsky.E</Authors>
        <Copyright>MonixOne</Copyright>
        <Version>1.1.0</Version>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/Shulyakovskiy/MonixOne.Security.Authentication</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Shulyakovskiy/MonixOne.Security.Authentication</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../../assets/nuget-icon.png" Link="nuget-icon.png" Pack="true" PackagePath="/" />
        <None Include="../../README.md" Link="README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

</Project>
